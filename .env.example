# Copy to .env. Never commit a real API key.
# Read from the project root by lexaudit/config/settings.py.

# Alem.ai: choose a model available to your API key.
# gemma4 was exercised in the authenticated probe; see docs/alem-api.md.
ALEM_API_KEY=
ALEM_BASE_URL=https://llm.alem.ai/v1
ALEM_MODEL=gemma4
LLM_TOOL_MODE=auto
LLM_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0
LLM_TIMEOUT_SECONDS=60.0
# Logs may contain contract/model text. Set to 0 to omit LLM content.
LLM_LOG_CONTENT_LIMIT=2000

# Analysis: keep per_block as default pending human approval of A/B results.
AGENT_MODE=per_block
AGENT_MAX_STEPS=6
AGENT_CONTEXT_SUMMARY_LIMIT=300
AGENT_TRACE_SUMMARY_LIMIT=300
AGENT_LAW_CONTEXT_ARTICLES=5
AGENT_LAW_CONTEXT_MAX_CHARS=12000
SECTION_MAX_CHARS=6000
EVIDENCE_CONCURRENCY=6
EVIDENCE_ACTS=2
VERDICT_CONCURRENCY=6

# Adilet search and local full-text mirror
ADILET_BASE_URL=https://adilet.zan.kz
ADILET_SEARCH_BASE_URL=https://old.adilet.zan.kz
SEARCH_CACHE_TTL_DAYS=7
ACT_REFRESH_DAYS=90

# API: inline uses background threads. Celery is not implemented yet.
PIPELINE_MODE=inline
API_MAX_WORKERS=2
MAX_UPLOAD_BYTES=10485760
PIPELINE_OUTPUT_DIR=out

# Relative paths resolve against the project root.
DATABASE_PATH=data/lexaudit.db
LOG_DIR=logs
PROMPTS_VERSION=v1
LOG_LEVEL=INFO
